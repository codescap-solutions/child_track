# Minimum iOS version required by GoogleMaps (16.0) and workmanager_apple (14.0)
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # ── 1. Clamp every Pod target to iOS 16.0 ──────────────────────────────────
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || current.to_f < 16.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end
  end

  # ── 2. Patch FlutterGeneratedPluginSwiftPackage/Package.swift ──────────────
  # Flutter hard-codes .iOS("13.0") in this generated file; workmanager-apple
  # requires 14.0+. We patch it here (post_install) so it survives pod install.
  # The file is also regenerated by Flutter's Xcode build phase — the Runner
  # target's "IPHONEOS_DEPLOYMENT_TARGET" build setting (set in step 3) tells
  # Flutter which version to write, so after the first clean build the generated
  # file will already contain 16.0 and this patch becomes a no-op.
  generated_package_swift = File.expand_path(
    '../Flutter/ephemeral/Packages/FlutterGeneratedPluginSwiftPackage/Package.swift',
    __FILE__
  )
  if File.exist?(generated_package_swift)
    content = File.read(generated_package_swift)
    patched = content.gsub(/\.iOS\("[0-9]+\.[0-9]+"\)/, '.iOS("16.0")')
    if content != patched
      File.write(generated_package_swift, patched)
      puts "✅ Patched FlutterGeneratedPluginSwiftPackage/Package.swift → iOS 16.0"
    end
  end

  # ── 3. Set deployment target on the generated SPM Xcode target itself ───────
  # CocoaPods integrates the Swift package as an aggregate target in the Pods
  # project; its own IPHONEOS_DEPLOYMENT_TARGET must also be >= 14.0 or Xcode
  # will reject it regardless of what the .swift file says.
  installer.pods_project.targets.each do |target|
    if target.name == 'FlutterGeneratedPluginSwiftPackage'
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end
  end
end

